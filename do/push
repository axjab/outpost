#!/usr/bin/env bash

set -euo pipefail

readonly IMAGE="ghcr.io/axjab/outpost"
readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly VERSION_FILE="${ROOT}/VERSION"

main() {
    check_version
    check_dependencies

    OUTPOST_VERSION="$(<"${VERSION_FILE}")"
    check_local_images

    echo "Pushing ${IMAGE}:${OUTPOST_VERSION}"
    docker push "${IMAGE}:${OUTPOST_VERSION}"

    echo "Pushing ${IMAGE}:latest"
    docker push "${IMAGE}:latest"

    echo "Push complete: ${IMAGE}"
}

check_version() {
    if [[ ! -f "${VERSION_FILE}" || ! -r "${VERSION_FILE}" ]]; then
        echo "ERROR: VERSION file is missing or unreadable: ${VERSION_FILE}" >&2
        exit 1
    fi

    local version
    version="$(<"${VERSION_FILE}")"

    if [[ ! "${version}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ || "${version}" == "latest" ]]; then
        echo "ERROR: Invalid version in VERSION: ${version}" >&2
        exit 1
    fi
}

check_dependencies() {
    local command
    for command in docker; do
        if ! command -v "${command}" >/dev/null 2>&1; then
            echo "ERROR: Required command not found: ${command}" >&2
            exit 1
        fi
    done
}

check_local_images() {
    local tag
    for tag in "${OUTPOST_VERSION}" latest; do
        if ! docker image inspect "${IMAGE}:${tag}" >/dev/null 2>&1; then
            echo "ERROR: Local image not found: ${IMAGE}:${tag}" >&2
            echo "Run ./do/build first." >&2
            exit 1
        fi
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
