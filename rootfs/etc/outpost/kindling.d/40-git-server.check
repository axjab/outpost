#!/usr/bin/env bash
set -euo pipefail
source /usr/lib/outpost/kindling/common.sh

has_ssh_host git
command -v timeout >/dev/null 2>&1
command -v ssh >/dev/null 2>&1
status=0
if output=$(timeout 4 ssh -o BatchMode=yes -o ConnectTimeout=3 -T git 2>&1); then
    status=0
else
    status=$?
fi
[[ $status == 0 || $status == 1 || $status == 128 ]]
[[ $output == *"Run with no arguments or with -c cmd"* ]]
