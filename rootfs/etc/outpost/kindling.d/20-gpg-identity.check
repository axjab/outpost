#!/usr/bin/env bash
set -euo pipefail
source /usr/lib/outpost/kindling/common.sh

command -v gpg >/dev/null 2>&1
fingerprint=$(machine_info_value GPG_FP)
[[ $fingerprint =~ ^[[:xdigit:]]{40}$ ]]
gpg --batch --with-colons --list-secret-keys "$fingerprint" | awk -F: -v fp="$fingerprint" '$1 == "fpr" && toupper($10) == toupper(fp) { found = 1 } END { exit !found }'
